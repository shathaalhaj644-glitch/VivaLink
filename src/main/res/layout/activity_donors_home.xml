<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDonorsHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    tools:context=".DonorsHomeActivity">

    <!-- رسالة الترحيب -->
    <TextView
        android:id="@+id/tvWelcomeDonor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مرحباً بك، متبرع"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:textColor="@android:color/black"/>

    <!-- عدد التبرعات -->
    <TextView
        android:id="@+id/tvDonationCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="عدد تبرعاتك: 0"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:textColor="@android:color/black"/>

    <!-- آخر تاريخ تبرع -->
    <TextView
        android:id="@+id/tvLastDonationDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="آخر تبرع: لا يوجد"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        android:textColor="@android:color/black"/>

    <!-- زر عرض جميع الطلبات -->
    <Button
        android:id="@+id/btnViewAllRequests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="عرض جميع الطلبات"
        android:textColor="@android:color/white"
        android:padding="12dp"/>

</LinearLayout>
