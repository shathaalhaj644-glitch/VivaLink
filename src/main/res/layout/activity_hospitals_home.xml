<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    tools:context=".HospitalsHomeActivity">

    <TextView
        android:id="@+id/tvHospitalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مستشفى: جاري التحميل..."
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:textColor="@android:color/black"/>

    <TextView
        android:id="@+id/tvRequestStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="حالة الطلبات: --"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        android:textColor="@android:color/black"/>

    <Button
        android:id="@+id/btnNewRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إرسال طلب جديد"
        android:backgroundTint="#D32F2F"
        android:textColor="@android:color/white"/>

</LinearLayout>