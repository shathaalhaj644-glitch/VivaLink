<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- عنوان الصفحة -->
        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تسجيل الدخول"
            android:textColor="#D32F2F"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <!-- إدخال البريد الإلكتروني أو رقم الهاتف -->
        <EditText
            android:id="@+id/etLoginEmailOrPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="البريد الإلكتروني أو رقم الهاتف"
            android:inputType="textEmailAddress|phone"
            android:drawableStart="@android:drawable/ic_menu_send"
            android:drawablePadding="8dp"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- إدخال كلمة المرور -->
        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="كلمة المرور"
            android:inputType="textPassword"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="8dp"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>

        <!-- زر تسجيل الدخول -->
        <Button
            android:id="@+id/btnSubmitLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تسجيل الدخول"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:layout_marginBottom="20dp"/>

        <!-- زر إنشاء حساب (للمتبرعين فقط) -->
        <Button
            android:id="@+id/btnGoToSignUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إنشاء حساب (للمتبرعين فقط)"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"/>

    </LinearLayout>
</ScrollView>
