<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEEEEE"
    android:layoutDirection="rtl"> <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/recyclerView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_above="@id/btn_add_new_request"
    android:padding="8dp"
    android:clipToPadding="false" /> <Button
    android:id="@+id/btn_add_new_request"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:layout_alignParentBottom="true"
    android:layout_margin="16dp"
    android:text="إضافة طلب جديد +"
    android:backgroundTint="#D32F2F"
    android:textColor="#FFFFFF"
    android:textSize="18sp"
    android:textStyle="bold" />

</RelativeLayout>