<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="#FFD1DC"
    android:orientation="vertical"
    android:padding="16dp"
    android:layoutDirection="rtl">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tvBloodType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🩸"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:text="📌"
            android:textColor="#808080"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/tvUnits" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧪" android:textColor="#000000" android:textSize="16sp" />
        <TextView android:id="@+id/tvDepartment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏢" android:textColor="#000000" android:textSize="16sp" />
        <TextView android:id="@+id/tvCity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textColor="#000000" android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🕒"
            android:textColor="#555555"
            android:textSize="13sp"
            android:layoutDirection="ltr"
            android:textAlignment="viewStart" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDonatedTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#E8F5E9"
        android:gravity="center"
        android:padding="10dp"
        android:text="تم التبرع ✅"
        android:textColor="#4CAF50"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btnChangeStatus" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:backgroundTint="#808080" android:text="الحالة ⚙️" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:layout_marginStart="5dp" android:backgroundTint="#FF0000" android:text="حذف 🗑️" android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>