<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إنشاء طلب جديد"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="25dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FCE4EC"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/et_hospitalName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="جاري تحميل الاسم..."
                    android:textColor="#B71C1C"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/et_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="المدينة"
                    android:textColor="#757575"
                    android:textSize="16sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تفاصيل الطلب"
            android:textColor="#B71C1C"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp"/>

        <Spinner
            android:id="@+id/sp_bloodType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/et_units"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="عدد الوحدات المطلوبة"
            android:inputType="number"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/et_department"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="القسم (مثلاً: الطوارئ)"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btn_create_request"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="إنشاء الطلب"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B71C1C"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>