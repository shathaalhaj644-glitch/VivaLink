<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFF9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layoutDirection="rtl">

        <TextView
            android:id="@+id/tvBloodType"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="#FFDADA"
            android:gravity="center"
            android:text="A+"
            android:textColor="#E64A41"
            android:textStyle="bold"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="15dp">

            <TextView
                android:id="@+id/tvDonorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم المتبرع"
                android:textColor="#333333"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDonorCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المدينة"
                android:textColor="#888888"
                android:textSize="13sp"
                android:drawableStart="@android:drawable/ic_menu_mylocation"
                android:drawablePadding="5dp" />

            <TextView
                android:id="@+id/tvDonationInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩸عدد التبرعات: 0 | 📅 آخر تبرع: N/A"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCall"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="#FFEAEA"
            android:src="@android:drawable/stat_sys_phone_call"
            app:tint="#E64A41" />

    </LinearLayout>
</androidx.cardview.widget.CardView>