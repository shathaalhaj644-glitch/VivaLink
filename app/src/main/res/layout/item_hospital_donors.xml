<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/tvBloodType"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="#FFEBEE"
                android:gravity="center"
                android:text="A+"
                android:textColor="#D32F2F"
                android:textStyle="bold"
                android:textSize="22sp"
                android:padding="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp">

                <TextView
                    android:id="@+id/tvDonorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اسم المتبرع"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDonorCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نابلس 📍"
                    android:textColor="#757575"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDonationCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🩸 عدد التبرعات: 5"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCall"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_call"
                app:tint="#2E7D32"
                android:scaleType="centerInside" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#EEEEEE"
            android:layout_marginVertical="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ بانتظار الفحص"
                android:textColor="#757575"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 لا توجد ملاحظات طبية"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:padding="8dp"
                android:background="#F9F9F9"/>

            <TextView
                android:id="@+id/tvLastBloodTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 آخر فحص دم: لا يوجد"
                android:textColor="#1976D2"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvLastDonation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 آخر تبرع: لا يوجد"
                android:textColor="#BDBDBD"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>