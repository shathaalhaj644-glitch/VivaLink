<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="#F2F2F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tabSend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="15dp"
            android:text="إرسال إشعار"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#EEEEEE"/>

        <TextView
            android:id="@+id/tabReceive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="15dp"
            android:text="الإشعارات الواردة"
            android:textColor="#757575"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#D32F2F" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/layoutSend"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إشعار عاجل للمتبرعين"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#D32F2F"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📢 إرسال إشعار جماعي عاجل"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLocationInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="جاري التحميل..."
                        android:textColor="#FFCDD2"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الفصائل المستهدفة"
                    android:layout_marginTop="15dp"
                    android:textStyle="bold"/>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:layout_marginTop="5dp">

                    <TableRow>
                        <CheckBox android:id="@+id/cbAp" android:text="A+" />
                        <CheckBox android:id="@+id/cbAn" android:text="A-" />
                        <CheckBox android:id="@+id/cbBp" android:text="B+" />
                        <CheckBox android:id="@+id/cbBn" android:text="B-" />
                    </TableRow>

                    <TableRow>
                        <CheckBox android:id="@+id/cbOp" android:text="O+" />
                        <CheckBox android:id="@+id/cbOn" android:text="O-" />
                        <CheckBox android:id="@+id/cbABp" android:text="AB+" />
                        <CheckBox android:id="@+id/cbABn" android:text="AB-" />
                    </TableRow>

                </TableLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مستوى الأولوية"
                    android:layout_marginTop="15dp"
                    android:textStyle="bold"/>

                <RadioGroup
                    android:id="@+id/rgPriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/rbUrgent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عاجل" />
                    <RadioButton android:id="@+id/rbNormal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عادي" android:layout_marginRight="20dp"/>
                </RadioGroup>

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="10dp"
                    android:background="#E0E0E0"
                    android:gravity="top"
                    android:hint="اكتب نص الرسالة هنا..."
                    android:padding="10dp" />

                <Button
                    android:id="@+id/btnSendNotification"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#D32F2F"
                    android:text="إرسال الإشعار"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </ScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvIncomingAdmin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="5dp"/>

    </FrameLayout>

</LinearLayout>