<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:text="VivaLink"
            android:textColor="#E62020"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- الاسم الكامل -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="الاسم الكامل" />

        <!-- البريد الإلكتروني -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="البريد الإلكتروني"
            android:inputType="textEmailAddress" />

        <!-- رقم الهاتف -->
        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="رقم الهاتف"
            android:inputType="phone" />

        <!-- المدينة -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اختر مدينتك" />
        <Spinner
            android:id="@+id/spCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <!-- فصيلة الدم -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="فصيلة الدم" />
        <Spinner
            android:id="@+id/spBloodType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp" />

        <!-- حالة التبرع -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="هل تبرعت من قبل؟" />
        <RadioGroup
            android:id="@+id/rgDonationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbDonatedYes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="نعم" />
            <RadioButton android:id="@+id/rbNeverDonated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="لا" android:checked="true" />
        </RadioGroup>

        <EditText
            android:id="@+id/etLastDonation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="تاريخ آخر تبرع"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etDonationCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="عدد التبرعات السابقة"
            android:inputType="number"
            android:visibility="gone" />

        <!-- الأمراض -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="هل تعاني من أمراض؟" />
        <RadioGroup
            android:id="@+id/rgHasDisease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbDiseaseYes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="نعم" />
            <RadioButton android:id="@+id/rbDiseaseNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="لا" android:checked="true" />
        </RadioGroup>

        <EditText
            android:id="@+id/etDiseaseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اسم المرض"
            android:visibility="gone" />

        <!-- كلمة السر -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="كلمة السر"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="تأكيد كلمة السر"
            android:inputType="textPassword" />

        <!-- أزرار -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E62020"
            android:text="إنشاء حساب"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#757575"
            android:text="العودة"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>