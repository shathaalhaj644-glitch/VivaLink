<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#F8F9FA"
    tools:context=".VerifyCodeActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="30dp"
            android:background="#FFFFFF">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#D32F2F"
                android:layout_marginBottom="25dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تأكيد الحساب"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أدخل الرمز المكون من 6 أرقام للتحقق من هويتك"
                android:textSize="14sp"
                android:textColor="#6C757D"
                android:gravity="center"
                android:layout_marginBottom="35dp"/>

            <EditText
                android:id="@+id/etCode"
                android:layout_width="220dp"
                android:layout_height="60dp"
                android:background="@android:drawable/editbox_background"
                android:gravity="center"
                android:hint="0 0 0 0 0 0"
                android:inputType="number"
                android:maxLength="6"
                android:letterSpacing="0.4"
                android:textSize="28sp"
                android:textColor="#212529"
                android:textStyle="bold"
                android:layout_marginBottom="35dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="تأكيد الرمز"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#D32F2F" />

            <TextView
                android:id="@+id/tvResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="لم يصلك الرمز؟ إعادة إرسال"
                android:layout_marginTop="20dp"
                android:textColor="#6C757D"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>