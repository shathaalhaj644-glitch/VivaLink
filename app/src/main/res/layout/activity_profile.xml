<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حسابي الشخصي"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#E62020"
            android:layout_gravity="center"
            android:layout_marginBottom="25dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">

                <TextView
                    android:text="👤 المعلومات الشخصية"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>

                <TextView android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الاسم: جاري التحميل..."
                    android:padding="5dp"
                    android:textSize="16sp"/>

                <TextView android:id="@+id/profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الايميل: info@example.com"
                    android:padding="5dp"
                    android:textSize="16sp"/>

                <TextView android:id="@+id/profile_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الهاتف: 059xxxxxxx"
                    android:padding="5dp"
                    android:textSize="16sp"/>

                <TextView android:id="@+id/profile_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="المدينة: نابلس"
                    android:padding="5dp"
                    android:textSize="16sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">

                <TextView
                    android:text="🩸 معلومات التبرع"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#E62020"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>

                <TextView android:id="@+id/last_donation_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="آخر تبرع: 10-02-2025"
                    android:padding="5dp"
                    android:textSize="16sp"/>

                <TextView android:id="@+id/donation_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="عدد التبرعات: 3"
                    android:padding="5dp"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">

                <TextView
                    android:text="⚙️ الإعدادات"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="10dp"/>

                <TextView android:id="@+id/edit_profile_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تعديل الحساب"
                    android:textColor="#007BFF"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:background="?attr/selectableItemBackground"/>

                <TextView android:id="@+id/change_password_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تغيير كلمة المرور"
                    android:textColor="#007BFF"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:background="?attr/selectableItemBackground"/>

                <TextView android:id="@+id/notification_settings_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إعدادات الإشعارات"
                    android:textColor="#007BFF"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:background="?attr/selectableItemBackground"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>