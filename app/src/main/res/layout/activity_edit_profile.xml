<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <TextView
            android:id="@+id/tvBloodType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="فصيلة الدم: (لا يمكن تغييرها)"
            android:textStyle="bold"
            android:paddingBottom="15dp"/>


        <EditText android:id="@+id/etName"
            android:hint="الاسم الكامل"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText android:id="@+id/etEmail"
            android:hint="البريد الإلكتروني"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText android:id="@+id/etPhone"
            android:hint="رقم الهاتف"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText android:id="@+id/etCity"
            android:hint="المدينة"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <TextView
            android:text="هل تعاني من أمراض مزمنة؟"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"/>

        <RadioGroup
            android:id="@+id/rgHealth"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbYes"
                android:text="نعم"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/rbNo"
                android:text="لا"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RadioGroup>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سجل التبرع"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"/>

        <EditText
            android:id="@+id/etLastDonation"
            android:hint="تاريخ آخر تبرع"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"/>

        <CheckBox
            android:id="@+id/cbNeverDonated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لم أتبرع من قبل"/>


        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ التعديلات"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@android:color/white"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>