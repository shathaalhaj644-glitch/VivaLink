<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="VivaLink"
            android:textColor="#FF4433"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFE5E5"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">
            <TextView
                android:id="@+id/tvWelcomeDonor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:text="أهلاً بك! تبرعك قد ينقذ حياة 🖐️"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnNotificationsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#F5F5F5"
            app:cardCornerRadius="15dp"
            app:cardElevation="1dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="صندوق الإشعارات"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔"
                    android:textSize="20sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardBloodTestAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="#F3E5F5" app:cardCornerRadius="15dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvBloodTestStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⏰ حان موعد فحصك الدوري!"
                        android:textColor="#4A148C" android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDaysSinceLastTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مر 120 يوماً على آخر فحص.\nلا يمكنك التبرع قبل إتمام الفحص وقبوله."
                    android:textColor="#6A1B9A"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="4dp"/>

                <Button
                    android:id="@+id/btnMarkBloodTest"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="رفع صورة الفحص"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#8E24AA" android:textStyle="bold"
                    android:textSize="14sp"
                    app:cornerRadius="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardUrgentRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FF4433"
            app:cardCornerRadius="25dp"
            app:cardElevation="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="25dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🩸 طلب دم عاجل"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/tvHospitalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المستشفى: --"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvBloodType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الفصيلة: --"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>
                <TextView
                    android:id="@+id/tvUnits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الوحدات المطلوبة: --"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvRequestDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 تاريخ الطلب: --"
                    android:textColor="#EEEEEE"
                    android:textSize="15sp"
                    android:layout_marginBottom="20dp"/>
                <Button
                    android:id="@+id/btnGoToDonate"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="تبرع الآن"
                    android:textColor="#FF4433"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="15dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/layoutNoRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="visible"
            app:cardCornerRadius="15dp"
            app:cardElevation="1dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="لا يوجد طلبات تبرع في مدينتك حالياً 🏠"
                android:gravity="center"
                android:textColor="#888888"
                android:textSize="15sp"/>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnViewRequests"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="عرض جميع الطلبات"
            android:backgroundTint="#FF4433"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إحصائياتك"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                app:cardBackgroundColor="#F8F8F8"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="آخر تبرع"
                        android:textSize="13sp"
                        android:textColor="#777777"/>
                    <TextView
                        android:id="@+id/tvLastDonationDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                app:cardBackgroundColor="#F8F8F8"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عدد التبرعات"
                        android:textSize="13sp"
                        android:textColor="#777777"/>
                    <TextView
                        android:id="@+id/tvDonationCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF4433"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <Button
            android:id="@+id/btnGoToProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="الملف الشخصي"
            android:backgroundTint="#FFFFFF"
            android:textColor="#555555"
            android:textSize="15sp"
            app:cornerRadius="15dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DDDDDD"
            android:layout_marginBottom="30dp"/>
    </LinearLayout>
</ScrollView>