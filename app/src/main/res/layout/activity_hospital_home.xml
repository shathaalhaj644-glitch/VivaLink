<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:layoutDirection="rtl">

    <View
        android:id="@+id/viewHeader"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="#E64A41"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VivaLink 🩸"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardHospital"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="100dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="25dp"
        app:cardElevation="12dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tvHospitalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جاري التحميل... ⏳"
                android:textColor="#E64A41"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:id="@+id/tvHospitalLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المدينة 📍"
                android:textColor="#757575"
                android:textSize="18sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/labelStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="25dp"
        android:text="نظرة عامة📊"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardHospital" />

    <LinearLayout
        android:id="@+id/linStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/labelStats">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_margin="10dp"
            app:cardBackgroundColor="#F5F5F5"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:id="@+id/valTotalRequests" android:text="0" android:textSize="28sp" android:textStyle="bold" android:textColor="#E64A41" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="إجمالي الطلبات📋" android:textColor="#424242" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_margin="10dp"
            app:cardBackgroundColor="#F5F5F5"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:id="@+id/valPending" android:text="0" android:textSize="28sp" android:textStyle="bold" android:textColor="#E64A41" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="طلبات مفتوحة🔓" android:textColor="#424242" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardDonorsCity"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#F5F5F5"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/linStats">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="25dp">
            <TextView android:id="@+id/valDonors" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="0" android:textColor="#E64A41" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="15dp" android:layout_toEndOf="@id/valDonors" android:text="متبرعون في مدينتك🏙️" android:textColor="#424242" android:textSize="17sp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/labelQuick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="25dp"
        android:text="الوصول السريع⚡"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardDonorsCity" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/labelQuick">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnViewDonorsCard"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="المتبرعون👥" android:textColor="#E64A41" android:textSize="14sp" android:textStyle="bold" android:background="#EEEEEE"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnCreateRequestCard"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="إنشاء طلب➕" android:textColor="#E64A41" android:textSize="14sp" android:textStyle="bold" android:background="#EEEEEE"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnSettingsCard"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="إعدادات⚙️"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#E64A41"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#EEEEEE"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>