<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إضافة طلب تبرع"
            android:textColor="#B71C1C"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp"/>

        <EditText
            android:id="@+id/et_bloodType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="فصيلة الدم (مثلاً +O)"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/et_hospitalName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="اسم المستشفى"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/et_city"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="المدينة"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/et_units"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="عدد الوحدات المطلوبة"
            android:inputType="number"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/et_department"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="القسم"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/et_status"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="الحالة (عاجل / مستقر)"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/btn_create_request"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="حفظ الطلب"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B71C1C"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>