<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layoutDirection="rtl">

    <EditText
        android:id="@+id/etSearchDonor"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:background="#FFF5F5"
        android:hint="ابحث باسم المتبرع..."
        android:paddingHorizontal="15dp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:textColorHint="#D32F2F"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="الكل"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                style="@style/Widget.AppCompat.Button.Small"/>

            <Button android:id="@+id/btnAPlus" android:layout_width="55dp" android:layout_height="38dp" android:text="A+" android:backgroundTint="#FFEBEE" android:textColor="#D32F2F" android:layout_marginEnd="8dp" style="@style/Widget.AppCompat.Button.Small"/>
            <Button android:id="@+id/btnAMinus" android:layout_width="55dp" android:layout_height="38dp" android:text="A-" android:backgroundTint="#FFEBEE" android:textColor="#D32F2F" android:layout_marginEnd="8dp" style="@style/Widget.AppCompat.Button.Small"/>
            <Button android:id="@+id/btnBPlus" android:layout_width="55dp" android:layout_height="38dp" android:text="B+" android:backgroundTint="#FFEBEE" android:textColor="#D32F2F" android:layout_marginEnd="8dp" style="@style/Widget.AppCompat.Button.Small"/>
            <Button android:id="@+id/btnBMinus" android:layout_width="55dp" android:layout_height="38dp" android:text="B-" android:backgroundTint="#FFEBEE" android:textColor="#D32F2F" android:layout_marginEnd="8dp" style="@style/Widget.AppCompat.Button.Small"/>
            <Button android:id="@+id/btnOPlus" android:layout_width="55dp" android:layout_height="38dp" android:text="O+" android:backgroundTint="#FFEBEE" android:textColor="#D32F2F" android:layout_marginEnd="8dp" style="@style/Widget.AppCompat.Button.Small"/>
            <Button android:id="@+id/btnOMinus" android:layout_width="55dp" android:layout_height="38dp" android:text="O-" android:backgroundTint="#FFEBEE" android:textColor="#D32F2F" android:layout_marginEnd="8dp" style="@style/Widget.AppCompat.Button.Small"/>
            <Button android:id="@+id/btnABPlus" android:layout_width="60dp" android:layout_height="38dp" android:text="AB+" android:backgroundTint="#FFEBEE" android:textColor="#D32F2F" android:layout_marginEnd="8dp" style="@style/Widget.AppCompat.Button.Small"/>
            <Button android:id="@+id/btnABMinus" android:layout_width="60dp" android:layout_height="38dp" android:text="AB-" android:backgroundTint="#FFEBEE" android:textColor="#D32F2F" android:layout_marginEnd="8dp" style="@style/Widget.AppCompat.Button.Small"/>

        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginHorizontal="16dp" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="لا يوجد متبرعين حالياً لهذه الفصيلة 🩸"
        android:textColor="#AAAAAA"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDonors"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp" />

</LinearLayout>