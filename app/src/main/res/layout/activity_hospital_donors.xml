<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:layoutDirection="rtl">

    <!-- الهيدر -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#E62020"
        android:padding="15dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="المتبرعون - "
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>

    <!-- مربع البحث -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/header"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="18sp"
            android:layout_gravity="center_vertical"/>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="ابحث باسم المتبرع..."
            android:background="@android:color/transparent"
            android:paddingStart="10dp"
            android:textSize="14sp"
            android:singleLine="true"/>
    </LinearLayout>

    <!-- الفلاتر (زمرة الدم + الكل) -->
    <HorizontalScrollView
        android:id="@+id/filterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchContainer"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

            <Button android:id="@+id/btnAll" android:layout_width="wrap_content" android:layout_height="40dp" android:text="الكل" android:backgroundTint="#757575" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnAPlus" android:layout_width="wrap_content" android:layout_height="40dp" android:text="A+" android:backgroundTint="#E62020" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnAMinus" android:layout_width="wrap_content" android:layout_height="40dp" android:text="A-" android:backgroundTint="#E62020" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnBPlus" android:layout_width="wrap_content" android:layout_height="40dp" android:text="B+" android:backgroundTint="#E62020" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnBMinus" android:layout_width="wrap_content" android:layout_height="40dp" android:text="B-" android:backgroundTint="#E62020" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnOPlus" android:layout_width="wrap_content" android:layout_height="40dp" android:text="O+" android:backgroundTint="#E62020" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnOMinus" android:layout_width="wrap_content" android:layout_height="40dp" android:text="O-" android:backgroundTint="#E62020" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnABPlus" android:layout_width="wrap_content" android:layout_height="40dp" android:text="AB+" android:backgroundTint="#E62020" android:textColor="#FFFFFF" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnABMinus" android:layout_width="wrap_content" android:layout_height="40dp" android:text="AB-" android:backgroundTint="#E62020" android:textColor="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- قائمة المتبرعين -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDonors"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filterContainer"
        android:padding="8dp"
        android:clipToPadding="false"/>
</RelativeLayout>
