<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#D32F2F"
            android:padding="16dp">
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="→"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnBack"
                android:layout_marginEnd="15dp"
                android:text="التبرع بالدم"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="15dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="25dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#E0EBF5">

                    <TextView
                        android:id="@+id/tvBloodType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="فصيلة الدم: --"
                        android:textColor="#2A2A2A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/tvHospitalName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="اسم المستشفى: --"
                        android:textColor="#2A2A2A"
                        android:textSize="16sp"
                        android:gravity="end"
                        android:layout_marginBottom="5dp"/>

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الموقع: --"
                        android:textColor="#2A2A2A"
                        android:textSize="16sp"
                        android:gravity="end"
                        android:layout_marginBottom="5dp"/>

                    <TextView
                        android:id="@+id/tvDepartment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="القسم: --"
                        android:textColor="#2A2A2A"
                        android:textSize="16sp"
                        android:gravity="end"
                        android:layout_marginBottom="5dp"/>

                    <TextView
                        android:id="@+id/tvUnits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="عدد الوحدات: --"
                        android:textColor="#2A2A2A"
                        android:textSize="16sp"
                        android:gravity="end"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="وقت الوصول المتوقع"
                android:textColor="#333333"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etTime"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="اضغط لاختيار الوقت"
                android:focusable="false"
                android:clickable="true"
                android:paddingEnd="15dp"
                android:gravity="end"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="رقم الهاتف"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="أدخل الرقم"
                android:inputType="phone"
                android:gravity="end"
                android:paddingEnd="15dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="12dp"/>
            <EditText
                android:id="@+id/etConfirmPhone"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="تأكيد الرقم"
                android:inputType="phone"
                android:gravity="end"
                android:paddingEnd="15dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="25dp"/>

            <Button
                android:id="@+id/btnConfirmDonation"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="تأكيد التبرع"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>