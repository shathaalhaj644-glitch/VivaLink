<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="#F5F5F5">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        app:tabTextColor="#FFFFFF"
        app:tabSelectedTextColor="#FFEB3B"
        app:tabIndicatorColor="#FFEB3B"
        app:tabMode="fixed" />

    <EditText
        android:id="@+id/etSearchName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:hint="ابحث باسم المتبرع..."
        android:drawableStart="@android:drawable/ic_menu_search"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:id="@+id/layoutBloodTypeFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="5dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

            <Button android:id="@+id/btnToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اليوم فقط" android:backgroundTint="#9E9E9E" android:textColor="#FFFFFF" android:layout_margin="2dp" android:textSize="12sp" />
            <Button android:id="@+id/btnAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الكل" android:backgroundTint="#9E9E9E" android:textColor="#FFFFFF" android:layout_margin="2dp" android:textSize="12sp" />
            <Button android:id="@+id/btnAPlus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A+" android:backgroundTint="#9E9E9E" android:layout_margin="2dp" />
            <Button android:id="@+id/btnAMinus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A-" android:backgroundTint="#9E9E9E" android:layout_margin="2dp" />
            <Button android:id="@+id/btnBPlus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B+" android:backgroundTint="#9E9E9E" android:layout_margin="2dp" />
            <Button android:id="@+id/btnBMinus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B-" android:backgroundTint="#9E9E9E" android:layout_margin="2dp" />
            <Button android:id="@+id/btnOPlus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="O+" android:backgroundTint="#9E9E9E" android:layout_margin="2dp" />
            <Button android:id="@+id/btnOMinus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="O-" android:backgroundTint="#9E9E9E" android:layout_margin="2dp" />
            <Button android:id="@+id/btnABPlus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AB+" android:backgroundTint="#9E9E9E" android:layout_margin="2dp" />
            <Button android:id="@+id/btnABMinus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AB-" android:backgroundTint="#9E9E9E" android:layout_margin="2dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutTestFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/filterAllTests"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الكل"
            android:textColor="#333333"
            android:textSize="12sp" />

        <Button
            android:id="@+id/filterPending"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="معلق"
            android:textColor="#E65100"
            android:textSize="12sp" />

        <Button
            android:id="@+id/filterAccepted"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مقبول"
            android:textColor="#2E7D32"
            android:textSize="12sp" />

        <Button
            android:id="@+id/filterRejected"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مرفوض"
            android:textColor="#C62828"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDonorsList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="5dp"
        android:clipToPadding="false" />

</LinearLayout>