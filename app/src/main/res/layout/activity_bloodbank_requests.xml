<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#D32F2F"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الطلبات"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:layout_marginTop="-20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_margin="4dp"
            android:text="الكل"
            android:textSize="12sp"
            android:backgroundTint="#9E9E9E" />

        <Button
            android:id="@+id/btnFilterOpen"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_margin="4dp"
            android:text="مفتوح"
            android:textSize="12sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnFilterClosed"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_margin="4dp"
            android:text="مغلق"
            android:textSize="12sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#333333" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRequests"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutFilters"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnNewRequest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="20dp"
        android:backgroundTint="#EC407A"
        android:text="+ طلب جديد"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</RelativeLayout>